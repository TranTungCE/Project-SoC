# Tcl script to open Vivado GUI and view waveform
# Usage: vivado -gui -source view_waves_gui.tcl

create_project -in_memory -part xc7z020clg400-1
set_property include_dirs [list ./src] [current_fileset]
read_verilog -sv ./src/DatapathPipelined.sv
read_verilog -sv ./src/tb_DatapathPipelined.sv

# Load the VCD waveform generated by xsim
open_wave_database sim_tb.wdb
